# Copia este archivo como .env.local y llena los valores. Nunca subas .env.local al repositorio.
# En producción estos valores se configuran en Vercel > Settings > Environment Variables.

# Cadena de conexión de PostgreSQL en Supabase (usar la del pooler, con SSL)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:6543/postgres?sslmode=require"

# Secreto para firmar los JWT de sesión: mínimo 32 caracteres aleatorios.
# Generar con: openssl rand -base64 48
JWT_SECRET=""
